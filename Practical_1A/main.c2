/**
  @file           : main.c
  @brief          : Running light with timer interrupt skeleton
  */

// TASK 2: running light. One LED on at a time, 0 to 7 and back, one step per second.
// Timer setup is the same as Task 1.
// The point of this task is where the work happens.
// TIM16_IRQHandler does not touch any pins. It sets timer_event to 1 and returns.
// The main loop sees the flag, clears it, and does the eight pin writes.
// Reason: while the chip is inside an interrupt, other interrupts are blocked.
// A short handler keeps the system responsive. Task 3 onward needs this.
// The direction flip happens before the index steps, so LED0 and LED7 light
// once per pass instead of twice.

/* Includes ------------------------------------------------------------------*/
#include "main.h"
#include "stm32f0xx.h"
#include <stdint.h>

/* Private variables ---------------------------------------------------------*/
TIM_HandleTypeDef htim16; // same timer handle as Task 1, same PSC and ARR

// volatile because the ISR writes this and the main loop reads it.
// Without it the compiler sees nothing in while(1) changing the value, so it
// reads it once, keeps it in a register, and spins forever on an old copy.
volatile uint8_t timer_event = 0; // 1 means a second has passed, handled below

volatile uint8_t current_led = 0; // which LED is lit right now, 0 to 7
volatile int8_t direction = 1;    // +1 walking up the row, -1 walking back
                                  // signed, so it cannot be uint8_t

// Index to hardware lookup. The brief supplies these so the pattern code can
// say "LED 5" and stay readable instead of hard coding GPIO_PIN_5 everywhere.
// All eight happen to be on port B here, but the port array keeps the pattern
// code working unchanged if a board splits them across ports.
GPIO_TypeDef *led_ports[8] = {GPIOB, GPIOB, GPIOB, GPIOB,
                              GPIOB, GPIOB, GPIOB, GPIOB};
uint16_t led_pins[8] = {GPIO_PIN_0, GPIO_PIN_1, GPIO_PIN_2, GPIO_PIN_3,
                        GPIO_PIN_4, GPIO_PIN_5, GPIO_PIN_6, GPIO_PIN_7};

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);    // HSI at 8 MHz, identical to Task 1
static void MX_GPIO_Init(void);   // PB0 to PB7 as outputs
static void MX_TIM16_Init(void);  // 1 Hz update interrupt
void TIM16_IRQHandler(void);      // sets the flag and nothing else
void turn_off_all_leds(void);     // blank the row
void update_led_pattern(void);    // advance one step of the running light

// Writes all eight LEDs low. Called before lighting the new one so we never
// have to remember which LED was on last.
void turn_off_all_leds(void) {
  // task 2 solution start
  for (uint8_t i = 0; i < 8; i++) {
    HAL_GPIO_WritePin(led_ports[i], led_pins[i], GPIO_PIN_RESET);
  }
  // task 2 solution end
}

// One step of the running light. Clear, light the current index, then work out
// the next index.
void update_led_pattern(void) {
  // task 2 solution start
  turn_off_all_leds();
  HAL_GPIO_WritePin(led_ports[current_led], led_pins[current_led],
                    GPIO_PIN_SET);

  // The whole trick of this task. Flip direction AFTER lighting the end LED
  // but BEFORE stepping, so the end LED is displayed once and then left.
  // Flipping after the step would light 7, step to 8, notice, come back to 7,
  // and 7 would appear twice.
  // Trace: at 7 we light 7, set direction to -1, step to 6.
  //        at 0 we light 0, set direction to +1, step to 1.
  // Giving 0,1,2,3,4,5,6,7,6,5,4,3,2,1,0,1,2,... as the brief requires.
  if (current_led == 7) {
    direction = -1;
  } else if (current_led == 0) {
    direction = 1;
  }
  current_led += direction;
  // task 2 solution end
}

/**
  @brief  The application entry point.
  @retval int
*/
int main(void) {
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();
  MX_TIM16_Init();

  // Ensure all LEDs are off at start
  turn_off_all_leds();

  // Start the timer interrupt
  HAL_TIM_Base_Start_IT(&htim16);

  while (1) {
    // task 2 solution start
    // Poll the flag, clear it first, then do the slow GPIO work. Clearing
    // before the work rather than after means a timer tick landing mid update
    // is still seen on the next pass instead of being wiped out.
    if (timer_event) {
      timer_event = 0;
      update_led_pattern();
    }
    // task 2 solution end
  }
}

/**
  @brief System Clock Configuration (HSI 8 MHz)
*/
void SystemClock_Config(void) {
  LL_FLASH_SetLatency(LL_FLASH_LATENCY_0);
  while (LL_FLASH_GetLatency() != LL_FLASH_LATENCY_0) {
  }

  LL_RCC_HSI_Enable();
  while (LL_RCC_HSI_IsReady() != 1) {
  }

  LL_RCC_HSI_SetCalibTrimming(16);
  LL_RCC_SetAHBPrescaler(LL_RCC_SYSCLK_DIV_1);
  LL_RCC_SetAPB1Prescaler(LL_RCC_APB1_DIV_1);
  LL_RCC_SetSysClkSource(LL_RCC_SYS_CLKSOURCE_HSI);
  while (LL_RCC_GetSysClkSource() != LL_RCC_SYS_CLKSOURCE_STATUS_HSI) {
  }

  LL_SetSystemCoreClock(8000000);

  if (HAL_InitTick(TICK_INT_PRIORITY) != HAL_OK) {
    Error_Handler();
  }
}

/**
  @brief TIM16 Initialization Corrected for 1-second interrupt
*/
static void MX_TIM16_Init(void) {
  htim16.Instance = TIM16;
  htim16.Init.Prescaler = 7999;
  htim16.Init.CounterMode = TIM_COUNTERMODE_UP;
  htim16.Init.Period = 999;
  htim16.Init.ClockDivision = TIM_CLOCKDIVISION_DIV1;
  htim16.Init.RepetitionCounter = 0;
  htim16.Init.AutoReloadPreload = TIM_AUTORELOAD_PRELOAD_ENABLE;

  if (HAL_TIM_Base_Init(&htim16) != HAL_OK) {
    Error_Handler();
  }

  NVIC_EnableIRQ(TIM16_IRQn);
}

/**
  @brief GPIO Initialization PB0..PB7 as outputs for LEDs
*/
static void MX_GPIO_Init(void) {
  __HAL_RCC_GPIOB_CLK_ENABLE();
  GPIO_InitTypeDef GPIO_InitStruct = {0};

  GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
  GPIO_InitStruct.Pull = GPIO_NOPULL;
  GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;

  // Configure all 8 pins (PB0 to PB7)
  for (uint8_t i = 0; i < 8; i++) {
    GPIO_InitStruct.Pin = led_pins[i];
    HAL_GPIO_Init(led_ports[i], &GPIO_InitStruct);
  }
}

/**
  @brief TIM16 interrupt handler
*/
void TIM16_IRQHandler(void) {
  HAL_TIM_IRQHandler(&htim16); // clears UIF, otherwise this refires forever
  // task 2 solution start
  // Two register writes and out. No GPIO work here on purpose: while the CPU
  // is inside a handler other interrupts wait, so a long handler makes the
  // whole system late. Tasks 3 to 6 add buttons and an ADC that would suffer.
  timer_event = 1;
  // task 2 solution end
}

/**
  @brief Error handler
*/
void Error_Handler(void) {
  __disable_irq();
  while (1) {
  }
}
