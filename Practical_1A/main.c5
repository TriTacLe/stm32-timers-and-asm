// TASK 5: read a DC voltage on PA5 and show it as a bar of LEDs on PB0 to PB7.
// Written straight to registers, no HAL drivers.
// The ADC compares the input against the 3.3 V reference and reports the
// fraction as a 12 bit number. 0 V gives 0, 3.3 V gives 4095.
// Three ordering rules that break this silently if ignored:
// 1. Calibration only runs while the ADC is disabled. Enable it first and
//    calibration quietly does nothing.
// 2. After enabling, wait for the ready flag before starting a conversion.
// 3. Reading ADC1->DR gives the result and clears the done flag in one go.
//    No separate clear, and no reading it twice.
// Continuous mode means it converts, interrupts, then starts the next
// conversion by itself. main starts it once and then does nothing forever.
#include "main.h"

/* ---------- Function prototypes ---------- */
static void GPIO_Init(void);                 // PA5 analog in, PB0 to PB7 out
static void ADC_Init(void);                  // calibrate, configure, enable
static void write_led_byte(uint8_t pattern); // one write drives all eight LEDs

int main(void) {
  HAL_Init(); // only sets up SysTick and core clocks, no ADC involvement
  GPIO_Init();
  ADC_Init();

  // task 5 solution start
  // kick off the ADC once, continuous mode keeps it converting forever
  ADC1->CR |= ADC_CR_ADSTART;
  // task 5 solution end

  while (1) {
    /* everything happens in the ISR */
  }
}

/* ---------- GPIO Configuration ---------- */
static void GPIO_Init(void) {
  // task 5 solution start
  // clocks first, nothing on a port works before its clock is on
  RCC->AHBENR |= RCC_AHBENR_GPIOAEN | RCC_AHBENR_GPIOBEN;

  // PA5 goes analog for ADC_IN5, both MODER bits set gives 11
  GPIOA->MODER |= (3U << (5 * 2));

  // PB0 to PB7 as outputs. clear the low 16 MODER bits then write 01
  // per pin which is the 0x5555 pattern. ODR cleared so leds start off
  GPIOB->MODER &= ~0xFFFFU;
  GPIOB->MODER |= 0x5555U;
  GPIOB->ODR &= ~0xFFU;
  // task 5 solution end
}

/* ---------- ADC Configuration ---------- */
static void ADC_Init(void) {
  // task 5 solution start
  RCC->APB2ENR |= RCC_APB2ENR_ADCEN;

  // calibration only works while the ADC is disabled so make sure of that
  // first, then run it and wait for the hardware to finish
  if (ADC1->CR & ADC_CR_ADEN) {
    ADC1->CR |= ADC_CR_ADDIS;
    while (ADC1->CR & ADC_CR_ADEN) {
    }
  }
  ADC1->CR |= ADC_CR_ADCAL;
  while (ADC1->CR & ADC_CR_ADCAL) {
  }

  // channel 5 is PA5. slowest sampling time, 239.5 cycles, because the
  // pot is a slow DC signal and longer sampling gives a cleaner read
  ADC1->CHSELR = ADC_CHSELR_CHSEL5;
  ADC1->SMPR = 7U;

  // 12 bit resolution and right alignment are already the reset defaults,
  // clearing the bits just makes that explicit. CONT means it reconverts
  // on its own without us restarting it
  ADC1->CFGR1 &= ~(ADC_CFGR1_RES | ADC_CFGR1_ALIGN);
  ADC1->CFGR1 |= ADC_CFGR1_CONT;

  // fire an interrupt every time a conversion finishes
  ADC1->IER |= ADC_IER_EOCIE;
  NVIC_SetPriority(ADC1_COMP_IRQn, 1);
  NVIC_EnableIRQ(ADC1_COMP_IRQn);

  // clear a possibly stale ready flag by writing 1 to it, enable the
  // ADC and wait until it says it is ready
  ADC1->ISR |= ADC_ISR_ADRDY;
  ADC1->CR |= ADC_CR_ADEN;
  while (!(ADC1->ISR & ADC_ISR_ADRDY)) {
  }
  // task 5 solution end
}

/* ---------- Interrupt Service Routine ---------- */
void ADC1_COMP_IRQHandler(void) {
  if (ADC1->ISR & ADC_ISR_EOC) {
    // task 5 solution start
    // reading DR gives the 12 bit result and clears the EOC flag in one go
    uint32_t adc_val = ADC1->DR;

    // Map 0 to 4095 onto 0 to 8 LEDs. Integer division always truncates, so
    // adding half a step (2048 out of 4096) before dividing turns it into
    // round to nearest. Effect: LED k switches on at 512k minus 256 counts,
    // which is the threshold worked out in the report.
    // Multiply before divide, otherwise the division would reach zero first
    // and throw away all the precision.
    uint8_t leds_to_light = (uint8_t)((adc_val * 8 + 2048) / 4096);

    // Bar graph, not a binary number. k LEDs lit means the lowest k bits are 1.
    // 1 shifted up by k, minus 1, gives exactly that: k=3 gives 0b00000111.
    uint8_t output_pattern = (uint8_t)((1U << leds_to_light) - 1U);

    write_led_byte(output_pattern);
    // task 5 solution end
  }
}

/* ---------- Helper: write an 8-bit pattern to PB0-PB7 ---------- */
// Read, clear the low byte, or in the new pattern, write back. The read and
// mask matter: writing the pattern straight to ODR would also zero PB8 to
// PB15. All eight LEDs change in one store, so no visible tearing.
static void write_led_byte(uint8_t pattern) {
  uint32_t odr = GPIOB->ODR;
  odr &= ~(0xFFU);
  odr |= pattern;
  GPIOB->ODR = odr;
}
